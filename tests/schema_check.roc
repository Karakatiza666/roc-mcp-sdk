app [main!] { pkg: "../package/main.roc" }

import pkg.JsonValue
import pkg.SchemaCheck

main! = |_args| Ok({})

## SchemaCheck against zod 4.4.3 as the JS SDK 2.0.0 reports it. Each generated line is one
## tools/call of a JS server whose tool has a zod input schema (captured with throwaway node
## scripts): the schema is the JSON Schema that server lists for the tool, and the expected text
## is what follows "Invalid arguments for tool <name>: " in its answer (or, on success, the
## arguments its handler got).

json : Str -> JsonValue
json = |s| JsonValue.parse(s) ?? String("unparsable: ${s}")

fails : Str, Str -> Str
fails = |schema, value| match SchemaCheck.validate(json(schema), json(value)) {
	Ok(v) => "passed: ${v.to_str()}"
	Err(Invalid(issues)) => Str.join_with(issues, ", ")
}

passes : Str, Str, Str -> Bool
passes = |schema, value, expected| match SchemaCheck.validate(json(schema), json(value)) {
	Ok(v) => v.to_str() == expected
	Err(_) => Bool.False
}

expect SchemaCheck.js_number("1e21") == "1e+21"
expect SchemaCheck.js_number("-5.5e-7") == "-5.5e-7"
expect SchemaCheck.js_number("1E-7") == "1e-7"
expect SchemaCheck.js_number("0.30000000000000004") == "0.30000000000000004"
expect SchemaCheck.js_number("-0.000001") == "-0.000001"
expect SchemaCheck.js_number("0.0000001") == "1e-7"
expect SchemaCheck.js_number("1.50") == "1.5"
expect SchemaCheck.js_number("100") == "100"
expect SchemaCheck.js_number("1e2") == "100"
expect SchemaCheck.js_number("12.5e1") == "125"
expect SchemaCheck.js_number("-0") == "0"
expect SchemaCheck.js_number("1.25e-3") == "0.00125"
expect SchemaCheck.utf16_length("é") == 1 and SchemaCheck.utf16_length("e\u(0301)") == 2 and SchemaCheck.utf16_length("😀") == 2 and SchemaCheck.utf16_length("日本") == 2

# A schema that is not an object (`true`) accepts anything; unknown keywords are ignored.
expect passes("true", "[1]", "[1]")
expect passes("{\"type\":\"string\",\"pattern\":\"^a$\",\"format\":\"email\"}", "\"b\"", "\"b\"")

# additionalProperties as a schema checks the extra values and keeps them.
expect fails("{\"type\":\"object\",\"properties\":{},\"additionalProperties\":{\"type\":\"number\"}}", "{\"a\":\"x\"}") == "a: Invalid input: expected number, received string"
expect passes("{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"additionalProperties\":true}", "{\"z\":1,\"a\":\"x\"}", "{\"a\":\"x\",\"z\":1}")

# Generated from JS SDK 2.0.0 / zod 4.4.3 captures (tools/call with each zod schema).
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{}") == "text: Invalid input: expected string, received undefined" # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"text\":1}") == "text: Invalid input: expected string, received number" # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"text\":null}") == "text: Invalid input: expected string, received null" # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"text\":\"a\",\"times\":\"x\"}") == "times: Invalid input: expected number, received string" # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"times\":true}") == "text: Invalid input: expected string, received undefined, times: Invalid input: expected number, received boolean" # basic
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"text\":\"a\",\"extra\":1}", "{\"text\":\"a\"}") # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"text\":[\"a\"]}") == "text: Invalid input: expected string, received array" # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"text\":{\"type\":\"string\"},\"times\":{\"type\":\"number\"}},\"required\":[\"text\"]}", "{\"text\":{}}") == "text: Invalid input: expected string, received object" # basic
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":1.5}") == "n: Invalid input: expected int, received number" # int
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":\"1\"}") == "n: Invalid input: expected number, received string" # int
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":1e+300}") == "n: Too big: expected int to be <=9007199254740991" # int
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":9007199254740992}") == "n: Too big: expected int to be <=9007199254740991" # int
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":-9007199254740992}") == "n: Too small: expected int to be >=-9007199254740991" # int
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":2}", "{\"n\":2}") # int
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{}") == "n: Invalid input: expected number, received undefined" # int
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":1.5}") == "n: Invalid input: expected int, received number" # zint
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":9007199254740992}") == "n: Too big: expected int to be <=9007199254740991" # zint
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"n\":0}") == "n: Too small: expected number to be >0" # intpos
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"n\":-1}") == "n: Too small: expected number to be >0" # intpos
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"n\":1.5}") == "n: Invalid input: expected int, received number" # intpos
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"n\":-1.5}") == "n: Invalid input: expected int, received number" # intpos
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"n\":100000000000000000000}") == "n: Too big: expected int to be <=9007199254740991" # intpos
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":3,\"maximum\":5}},\"required\":[\"n\"]}", "{\"n\":2}") == "n: Too small: expected number to be >=3" # intminmax
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":3,\"maximum\":5}},\"required\":[\"n\"]}", "{\"n\":6}") == "n: Too big: expected number to be <=5" # intminmax
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":3,\"maximum\":5}},\"required\":[\"n\"]}", "{\"n\":2.5}") == "n: Invalid input: expected int, received number" # intminmax
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":-1}") == "n: Too small: expected number to be >=0" # intnonneg
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"number\",\"minimum\":1.5,\"maximum\":10},\"b\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"exclusiveMaximum\":5}},\"required\":[\"a\",\"b\"]}", "{\"a\":1,\"b\":0}") == "a: Too small: expected number to be >=1.5, b: Too small: expected number to be >0" # num
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"number\",\"minimum\":1.5,\"maximum\":10},\"b\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"exclusiveMaximum\":5}},\"required\":[\"a\",\"b\"]}", "{\"a\":11,\"b\":5}") == "a: Too big: expected number to be <=10, b: Too big: expected number to be <5" # num
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"number\",\"minimum\":1.5,\"maximum\":10},\"b\":{\"type\":\"number\",\"exclusiveMinimum\":0,\"exclusiveMaximum\":5}},\"required\":[\"a\",\"b\"]}", "{\"a\":2,\"b\":2}", "{\"a\":2,\"b\":2}") # num
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"number\",\"minimum\":-1e-06,\"maximum\":1e+21}},\"required\":[\"a\"]}", "{\"a\":2e+21}") == "a: Too big: expected number to be <=1e+21" # numbig
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"number\",\"minimum\":-1e-06,\"maximum\":1e+21}},\"required\":[\"a\"]}", "{\"a\":-1}") == "a: Too small: expected number to be >=-0.000001" # numbig
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":3}},\"required\":[\"s\"]}", "{\"s\":\"a\"}") == "s: Too small: expected string to have >=2 characters" # str
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":3}},\"required\":[\"s\"]}", "{\"s\":\"abcd\"}") == "s: Too big: expected string to have <=3 characters" # str
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":3}},\"required\":[\"s\"]}", "{\"s\":\"é\"}") == "s: Too small: expected string to have >=2 characters" # str
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":3}},\"required\":[\"s\"]}", "{\"s\":\"😀\"}", "{\"s\":\"😀\"}") # str
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2,\"maxLength\":3}},\"required\":[\"s\"]}", "{\"s\":\"😀😀\"}") == "s: Too big: expected string to have <=3 characters" # str
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1}},\"required\":[\"s\"]}", "{\"s\":\"\"}") == "s: Too small: expected string to have >=1 characters" # strone
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1}},\"required\":[\"s\"]}", "{\"s\":\"ab\"}") == "s: Too big: expected string to have <=1 characters" # strone
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"e\":{\"type\":\"string\",\"enum\":[\"a\",\"b\"]},\"f\":{\"type\":\"string\",\"enum\":[\"x\"]}},\"required\":[\"e\"]}", "{\"e\":\"c\"}") == "e: Invalid option: expected one of \"a\"|\"b\"" # enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"e\":{\"type\":\"string\",\"enum\":[\"a\",\"b\"]},\"f\":{\"type\":\"string\",\"enum\":[\"x\"]}},\"required\":[\"e\"]}", "{\"e\":1}") == "e: Invalid option: expected one of \"a\"|\"b\"" # enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"e\":{\"type\":\"string\",\"enum\":[\"a\",\"b\"]},\"f\":{\"type\":\"string\",\"enum\":[\"x\"]}},\"required\":[\"e\"]}", "{}") == "e: Invalid option: expected one of \"a\"|\"b\"" # enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"e\":{\"type\":\"string\",\"enum\":[\"a\",\"b\"]},\"f\":{\"type\":\"string\",\"enum\":[\"x\"]}},\"required\":[\"e\"]}", "{\"e\":\"a\",\"f\":\"y\"}") == "f: Invalid input: expected \"x\"" # enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"e\":{\"type\":\"string\",\"enum\":[\"a\",\"b\"]},\"f\":{\"type\":\"string\",\"enum\":[\"x\"]}},\"required\":[\"e\"]}", "{\"e\":\"a\",\"f\":null}") == "f: Invalid input: expected \"x\"" # enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"l\":{\"type\":\"string\",\"const\":\"x\"},\"m\":{\"type\":\"number\",\"const\":5},\"t\":{\"type\":\"boolean\",\"const\":true}},\"required\":[\"l\"]}", "{\"l\":\"y\"}") == "l: Invalid input: expected \"x\"" # literal
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"l\":{\"type\":\"string\",\"const\":\"x\"},\"m\":{\"type\":\"number\",\"const\":5},\"t\":{\"type\":\"boolean\",\"const\":true}},\"required\":[\"l\"]}", "{}") == "l: Invalid input: expected \"x\"" # literal
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"l\":{\"type\":\"string\",\"const\":\"x\"},\"m\":{\"type\":\"number\",\"const\":5},\"t\":{\"type\":\"boolean\",\"const\":true}},\"required\":[\"l\"]}", "{\"l\":\"x\",\"m\":6}") == "m: Invalid input: expected 5" # literal
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"l\":{\"type\":\"string\",\"const\":\"x\"},\"m\":{\"type\":\"number\",\"const\":5},\"t\":{\"type\":\"boolean\",\"const\":true}},\"required\":[\"l\"]}", "{\"l\":\"x\",\"t\":false}") == "t: Invalid input: expected true" # literal
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"l\":{\"type\":\"string\",\"enum\":[\"x\",\"y\"]}},\"required\":[\"l\"]}", "{\"l\":\"z\"}") == "l: Invalid option: expected one of \"x\"|\"y\"" # literals
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"b\":{\"type\":\"boolean\"},\"n\":{\"type\":\"null\"}},\"required\":[\"b\"]}", "{\"b\":\"true\"}") == "b: Invalid input: expected boolean, received string" # bool
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"b\":{\"type\":\"boolean\"},\"n\":{\"type\":\"null\"}},\"required\":[\"b\"]}", "{\"b\":true,\"n\":0}") == "n: Invalid input: expected null, received number" # bool
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"b\":{\"type\":\"boolean\"},\"n\":{\"type\":\"null\"}},\"required\":[\"b\"]}", "{}") == "b: Invalid input: expected boolean, received undefined" # bool
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"minItems\":1,\"maxItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"q\"]}", "{\"q\":[]}") == "q: Too small: expected array to have >=1 items" # array
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"minItems\":1,\"maxItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"q\"]}", "{\"q\":[1,2,3]}") == "q.0: Invalid input: expected string, received number, q.1: Invalid input: expected string, received number, q.2: Invalid input: expected string, received number, q: Too big: expected array to have <=2 items" # array
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"minItems\":1,\"maxItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"q\"]}", "{\"q\":\"x\"}") == "q: Invalid input: expected array, received string" # array
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"minItems\":1,\"maxItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"q\"]}", "{\"q\":[1]}") == "q.0: Invalid input: expected string, received number" # array
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"minItems\":1,\"maxItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}}},\"required\":[\"q\"]}", "{}") == "q: Invalid input: expected array, received undefined" # array
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"number\"}},\"required\":[\"a\"]}}},\"required\":[\"q\"]}", "{\"q\":[{\"a\":1},{},{\"a\":\"x\"}]}") == "q.1.a: Invalid input: expected number, received undefined, q.2.a: Invalid input: expected number, received string" # arrayobj
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}}},\"required\":[\"q\"]}", "{\"q\":[1.5,2]}") == "q.0: Invalid input: expected int, received number" # arrayint
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"o\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"number\"},\"y\":{\"type\":\"string\"}},\"required\":[\"x\"]}},\"required\":[\"o\"]}", "{\"o\":{}}") == "o.x: Invalid input: expected number, received undefined" # nested
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"o\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"number\"},\"y\":{\"type\":\"string\"}},\"required\":[\"x\"]}},\"required\":[\"o\"]}", "{\"o\":1}") == "o: Invalid input: expected object, received number" # nested
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"o\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"number\"},\"y\":{\"type\":\"string\"}},\"required\":[\"x\"]}},\"required\":[\"o\"]}", "{}") == "o: Invalid input: expected object, received undefined" # nested
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"o\":{\"type\":\"object\",\"properties\":{\"x\":{\"type\":\"number\"},\"y\":{\"type\":\"string\"}},\"required\":[\"x\"]}},\"required\":[\"o\"]}", "{\"o\":{\"x\":1,\"y\":2}}") == "o.y: Invalid input: expected string, received number" # nested
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":true}") == "u: Invalid input" # union
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{}") == "u: Invalid input" # union
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":null}") == "u: Invalid input" # union
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":5},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":\"ab\"}") == "u: Too small: expected string to have >=5 characters" # unionmin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":5},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":true}") == "u: Invalid input" # unionmin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":5},{\"type\":\"string\",\"maxLength\":1}]}},\"required\":[\"u\"]}", "{\"u\":\"abc\"}") == "u: Invalid input" # unionmin2
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]},{\"type\":\"object\",\"properties\":{\"b\":{\"type\":\"number\"}},\"required\":[\"b\"]}]}},\"required\":[\"u\"]}", "{\"u\":{}}") == "u: Invalid input" # unionobj
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]},{\"type\":\"object\",\"properties\":{\"b\":{\"type\":\"number\"}},\"required\":[\"b\"]}]}},\"required\":[\"u\"]}", "{\"u\":{\"a\":1}}") == "u: Invalid input" # unionobj
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"t\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"s\"]}", "{\"s\":1}") == "s: Invalid input: expected string, received number" # nullable
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"t\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"s\"]}", "{}") == "s: Invalid input: expected string, received undefined" # nullable
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"t\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]}},\"required\":[\"s\"]}", "{\"s\":null,\"t\":2}") == "t: Invalid input: expected string, received number" # nullable
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":false}", "{\"a\":\"x\",\"b\":1}") == "Unrecognized key: \"b\"" # strict
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":false}", "{\"b\":1,\"c\":2}") == "a: Invalid input: expected string, received undefined, Unrecognized keys: \"b\", \"c\"" # strict
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":false}", "{\"c\":1,\"a\":1}") == "a: Invalid input: expected string, received number, Unrecognized key: \"c\"" # strict
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"o\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"additionalProperties\":false}},\"required\":[\"o\"]}", "{\"o\":{\"z\":1}}") == "o: Unrecognized key: \"z\"" # strictnested
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":{}}", "{\"b\":1}") == "a: Invalid input: expected string, received undefined" # loose
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"query\":{\"minItems\":1,\"maxItems\":8,\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"limit\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"query\":5}") == "query: Invalid input: expected array, received number" # querylist
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"query\":{\"minItems\":1,\"maxItems\":8,\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"limit\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"query\":[]}") == "query: Too small: expected array to have >=1 items" # querylist
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"query\":{\"minItems\":1,\"maxItems\":8,\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"limit\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"query\":[1]}") == "query.0: Invalid input: expected string, received number" # querylist
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"query\":{\"minItems\":1,\"maxItems\":8,\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"limit\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}}}", "{\"query\":[\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\",\"a\"]}") == "query: Too big: expected array to have <=8 items" # querylist
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\"}}}", "{\"s\":null}") == "s: Invalid input: expected string, received null" # optnull
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{},\"u\":{}},\"required\":[\"a\",\"u\"]}", "{}") == "a: Invalid input: expected nonoptional, received undefined, u: Invalid input: expected nonoptional, received undefined" # any
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"r\":{\"type\":\"object\",\"propertyNames\":{\"type\":\"string\"},\"additionalProperties\":{\"type\":\"number\"}}},\"required\":[\"r\"]}", "{\"r\":{\"a\":\"x\"}}") == "r.a: Invalid input: expected number, received string" # record
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"r\":{\"type\":\"object\",\"propertyNames\":{\"type\":\"string\"},\"additionalProperties\":{\"type\":\"number\"}}},\"required\":[\"r\"]}", "{\"r\":[]}") == "r: Invalid input: expected record, received array" # record
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"string\"},\"b\":{\"type\":\"number\"},\"c\":{\"type\":\"boolean\"}},\"required\":[\"a\",\"b\",\"c\"]}", "{}") == "a: Invalid input: expected string, received undefined, b: Invalid input: expected number, received undefined, c: Invalid input: expected boolean, received undefined" # multi
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"string\"},\"b\":{\"type\":\"number\"},\"c\":{\"type\":\"boolean\"}},\"required\":[\"a\",\"b\",\"c\"]}", "{\"c\":1,\"b\":\"x\",\"a\":2}") == "a: Invalid input: expected string, received number, b: Invalid input: expected number, received string, c: Invalid input: expected boolean, received number" # multi
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"d\":{\"default\":3,\"type\":\"number\"}}}", "{\"d\":\"x\"}") == "d: Invalid input: expected number, received string" # default
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"d\":{\"default\":3,\"type\":\"number\"}}}", "{}", "{\"d\":3}") # default
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991},{\"type\":\"string\"}]}},\"required\":[\"u\"]}", "{\"u\":1.5}") == "u: Invalid input" # u_int_str
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991},{\"type\":\"string\"}]}},\"required\":[\"u\"]}", "{\"u\":1e+300}") == "u: Too big: expected int to be <=9007199254740991" # u_int_str
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"],\"additionalProperties\":false},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":{\"a\":\"x\",\"b\":1}}") == "u: Invalid input" # u_strict
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"a\"]},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":\"b\"}") == "u: Invalid input" # u_enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"minItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":[\"a\"]}") == "u: Too small: expected array to have >=2 items" # u_arrmin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"minItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":[1]}") == "u: Invalid input" # u_arrmin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"minItems\":2,\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":[1,\"a\"]}") == "u: Invalid input" # u_arrmin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":5},{\"type\":\"number\",\"minimum\":5}]}},\"required\":[\"u\"]}", "{\"u\":\"ab\"}") == "u: Too small: expected string to have >=5 characters" # u_twomin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":5},{\"type\":\"number\",\"minimum\":5}]}},\"required\":[\"u\"]}", "{\"u\":1}") == "u: Too small: expected number to be >=5" # u_twomin
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\",\"minLength\":3}},\"required\":[\"a\"]},{\"type\":\"number\"}]}},\"required\":[\"u\"]}", "{\"u\":{\"a\":\"x\"}}") == "u.a: Too small: expected string to have >=3 characters" # u_nested
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"number\"},{\"type\":\"null\"}]}},\"required\":[\"u\"]}", "{\"u\":true}") == "u: Invalid input" # u_three_null
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"null\"},{\"type\":\"string\"}]}},\"required\":[\"u\"]}", "{\"u\":1}") == "u: Invalid input" # u_null_first
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]},{\"type\":\"null\"}]}},\"required\":[\"u\"]}", "{\"u\":{}}") == "u.a: Invalid input: expected string, received undefined" # u_nullable_obj
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]},{\"type\":\"null\"}]}},\"required\":[\"u\"]}", "{\"u\":1}") == "u: Invalid input: expected object, received number" # u_nullable_obj
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"a\"]},{\"type\":\"null\"}]}},\"required\":[\"u\"]}", "{\"u\":1}") == "u: Invalid input: expected \"a\"" # u_nullable_enum
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"u\":{\"anyOf\":[{\"minItems\":1,\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"null\"}]}},\"required\":[\"u\"]}", "{\"u\":[]}") == "u: Too small: expected array to have >=1 items" # u_nullable_arr
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991},\"b\":{\"type\":\"integer\",\"minimum\":3,\"maximum\":5},\"c\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":-1}},\"required\":[\"a\",\"b\",\"c\"]}", "{\"a\":-9007199254740992,\"b\":100000000000000000000,\"c\":9007199254740992}") == "a: Too small: expected int to be >=-9007199254740991, a: Too small: expected number to be >0, b: Too big: expected int to be <=9007199254740991, b: Too big: expected number to be <=5, c: Too big: expected int to be <=9007199254740991, c: Too big: expected number to be <=-1" # intorder
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}", "{\"n\":9007199254740992}") == "n: Too big: expected int to be <=9007199254740991" # intnobound
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"number\",\"minimum\":0,\"maximum\":0}},\"required\":[\"n\"]}", "{\"n\":0.1}") == "n: Too big: expected number to be <=0" # numbounds
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"number\",\"minimum\":0,\"maximum\":0}},\"required\":[\"n\"]}", "{\"n\":-0.1}") == "n: Too small: expected number to be >=0" # numbounds
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"number\",\"minimum\":0.1,\"maximum\":0.30000000000000004},\"m\":{\"type\":\"number\",\"exclusiveMinimum\":-5.5e-07,\"exclusiveMaximum\":1e-07},\"k\":{\"type\":\"number\",\"minimum\":123456789012}},\"required\":[\"n\",\"m\",\"k\"]}", "{\"n\":0,\"m\":-1,\"k\":1}") == "n: Too small: expected number to be >=0.1, m: Too small: expected number to be >-5.5e-7, k: Too small: expected number to be >=123456789012" # frac
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"n\":{\"type\":\"number\",\"minimum\":0.1,\"maximum\":0.30000000000000004},\"m\":{\"type\":\"number\",\"exclusiveMinimum\":-5.5e-07,\"exclusiveMaximum\":1e-07},\"k\":{\"type\":\"number\",\"minimum\":123456789012}},\"required\":[\"n\",\"m\",\"k\"]}", "{\"n\":1,\"m\":1}") == "n: Too big: expected number to be <=0.30000000000000004, m: Too big: expected number to be <1e-7, k: Invalid input: expected number, received undefined" # frac
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"a\":{\"type\":\"array\",\"items\":{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"number\"}}}},\"required\":[\"a\"]}", "{\"a\":[[1,2],[\"x\"]]}") == "a.0: Too big: expected array to have <=1 items, a.1.0: Invalid input: expected number, received string" # arrnest
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{}}", "{\"a\":1}", "{}") # emptyobj
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{}}", "{}", "{}") # emptyobj
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{},\"additionalProperties\":false}", "{\"a\":1}") == "Unrecognized key: \"a\"" # strictempty
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"s\"]}", "{\"s\":\"😀\"}", "{\"s\":\"😀\"}") # strlen
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"s\"]}", "{\"s\":\"日本\"}", "{\"s\":\"日本\"}") # strlen
expect passes("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":2}},\"required\":[\"s\"]}", "{\"s\":\"é\"}", "{\"s\":\"é\"}") # strlen
expect fails("{\"type\":\"object\",\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"properties\":{\"q\":{\"minItems\":3,\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"r\":{\"type\":\"string\"}},\"required\":[\"q\",\"r\"]}", "{\"q\":[1],\"r\":1}") == "q.0: Invalid input: expected string, received number, q: Too small: expected array to have >=3 items, r: Invalid input: expected string, received number" # elems_after
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}}", "[1.5,2]") == "0: Invalid input: expected int, received number" # z3_0
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}}", "[2,\"x\"]") == "1: Invalid input: expected number, received string, Too big: expected array to have <=1 items" # z3_1
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}}", "[1e+300,2]") == "0: Too big: expected int to be <=9007199254740991, Too big: expected array to have <=1 items" # z3_2
expect fails("{\"minItems\":3,\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}}", "[1.5]") == "0: Invalid input: expected int, received number" # z3_3
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":5}}", "[\"a\",\"b\"]") == "0: Too small: expected string to have >=5 characters, 1: Too small: expected string to have >=5 characters, Too big: expected array to have <=1 items" # z3_4
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"a\"]}}", "[\"b\",\"c\"]") == "0: Invalid input: expected \"a\", 1: Invalid input: expected \"a\", Too big: expected array to have <=1 items" # z3_5
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"string\"}},\"required\":[\"a\"]}}", "[{},{}]") == "0.a: Invalid input: expected string, received undefined, 1.a: Invalid input: expected string, received undefined, Too big: expected array to have <=1 items" # z3_6
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"string\"}}", "[1,2]") == "0: Invalid input: expected string, received number, 1: Invalid input: expected string, received number, Too big: expected array to have <=1 items" # z3_7
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"]}}", "[{\"n\":1.5},{\"n\":1}]") == "0.n: Invalid input: expected int, received number" # z3_8
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}}}", "[[1.5],[1]]") == "0.0: Invalid input: expected int, received number" # z3_9
expect fails("{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"n\"],\"additionalProperties\":false}", "{\"n\":1.5,\"x\":1}") == "n: Invalid input: expected int, received number, Unrecognized key: \"x\"" # z3_10
expect fails("{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"string\"}},\"required\":[\"n\"],\"additionalProperties\":false}", "{\"n\":1,\"x\":1}") == "n: Invalid input: expected string, received number, Unrecognized key: \"x\"" # z3_11
expect fails("{\"type\":\"object\",\"properties\":{\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991},\"s\":{\"type\":\"string\"}},\"required\":[\"n\",\"s\"]}", "{\"n\":1.5,\"s\":1}") == "n: Invalid input: expected int, received number, s: Invalid input: expected string, received number" # z3_12
expect fails("{\"type\":\"object\",\"properties\":{\"s\":{\"type\":\"string\",\"minLength\":3},\"n\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"required\":[\"s\",\"n\"]}", "{\"s\":\"a\",\"n\":1.5}") == "s: Too small: expected string to have >=3 characters, n: Invalid input: expected int, received number" # z3_13
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"string\",\"minLength\":5}}", "[\"abcdef\",\"b\"]") == "1: Too small: expected string to have >=5 characters, Too big: expected array to have <=1 items" # z3_14
expect fails("{\"type\":\"integer\",\"exclusiveMinimum\":0,\"maximum\":9007199254740991}", "1.5") == "Invalid input: expected int, received number" # z3_15
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"string\",\"const\":\"a\"}}", "[\"b\",\"c\"]") == "0: Invalid input: expected \"a\", 1: Invalid input: expected \"a\", Too big: expected array to have <=1 items" # z3_16
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"number\"}]}}", "[true,1]") == "0: Invalid input, Too big: expected array to have <=1 items" # z3_17
expect fails("{\"maxItems\":1,\"type\":\"array\",\"items\":{\"anyOf\":[{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991},{\"type\":\"null\"}]}}", "[1.5,null]") == "0: Invalid input: expected int, received number" # z3_18
expect fails("{\"type\":\"object\",\"properties\":{\"q\":{\"maxItems\":1,\"type\":\"array\",\"items\":{\"type\":\"integer\",\"minimum\":-9007199254740991,\"maximum\":9007199254740991}},\"r\":{\"type\":\"string\",\"maxLength\":1}},\"required\":[\"q\",\"r\"]}", "{\"q\":[1.5,2],\"r\":\"ab\"}") == "q.0: Invalid input: expected int, received number, r: Too big: expected string to have <=1 characters" # z3_19
expect fails("{\"type\":\"integer\",\"minimum\":5,\"maximum\":9007199254740991}", "1.5") == "Invalid input: expected int, received number" # z3_20

# Known differences (DESIGN 7): `pattern` and `format` are not checked (zod: "Invalid string:
# must match pattern /^a+$/", "Invalid email address"), and a zod `preprocess` cannot be seen
# in the JSON Schema it emits (roc-syntax-mcp's QUERY_LIST accepts a string; skip validation for
# such a tool with `Server.tool_input_validation(name, Bool.False)`).
expect passes("{\"type\":\"object\",\"properties\":{\"s\":{\"type\":\"string\",\"pattern\":\"^a+$\"}},\"required\":[\"s\"]}", "{\"s\":\"b\"}", "{\"s\":\"b\"}")
expect fails("{\"type\":\"object\",\"properties\":{\"query\":{\"minItems\":1,\"maxItems\":8,\"type\":\"array\",\"items\":{\"type\":\"string\"}}}}", "{\"query\":\"x\"}") == "query: Invalid input: expected array, received string"

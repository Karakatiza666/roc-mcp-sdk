# Generated by gen_repro.py 30 plain. Headerless: runs on the built-in Echo platform.

Parts : { names : List(Str), limit : U64, tag : Str, verbose : Bool }

Step : { out : List(Str), count : U64, log : List(Str) }

reply : List(Str) -> Step
reply = |lines| { out: lines, count: 0, log: [] }

line : Parts, Str, Str -> Str
line = |parts, method, text| if (parts.verbose) "${parts.tag}:${method}:${text}" else text

allowed : Try(U64, [NoState]), U64 -> Bool
allowed = |maybe, k| match maybe {
	Ok(st) => st % (k + 2) != 1
	Err(NoState) => Bool.True
}

handler_0 : Parts, Try(U64, [NoState]), Str -> Step
handler_0 = |parts, maybe, text| {
	if !(allowed(maybe, 0)) {
		{ ..reply([line(parts, "m0", "disabled")]), log: ["m0 disabled"] }
	} else {
		picked = parts.names.keep_if(|x| x.count_utf8_bytes() > 0).map(|x| line(parts, "m0", "${x}${text}"))
		match picked.first() {
			Ok(f) if parts.limit > 0 => { ..reply(picked), count: picked.len(), log: [f] }
			Ok(_) => reply([line(parts, "m0", "over")])
			Err(_) => reply([line(parts, "m0", "none")])
		}
	}
}


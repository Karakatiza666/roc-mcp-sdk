dispatch : Parts, Try(U64, [NoState]), U64, Str -> Step
dispatch = |parts, maybe, method, text| match method {
	0 => handler_0(parts, maybe, text)
	1 => handler_1(parts, maybe, text)
	2 => handler_2(parts, maybe, text)
	3 => handler_3(parts, maybe, text)
	4 => handler_4(parts, maybe, text)
	5 => handler_5(parts, maybe, text)
	6 => handler_6(parts, maybe, text)
	7 => handler_7(parts, maybe, text)
	8 => handler_8(parts, maybe, text)
	9 => handler_9(parts, maybe, text)
	10 => handler_10(parts, maybe, text)
	11 => handler_11(parts, maybe, text)
	12 => handler_12(parts, maybe, text)
	13 => handler_13(parts, maybe, text)
	14 => handler_14(parts, maybe, text)
	15 => handler_15(parts, maybe, text)
	16 => handler_16(parts, maybe, text)
	17 => handler_17(parts, maybe, text)
	18 => handler_18(parts, maybe, text)
	19 => handler_19(parts, maybe, text)
	20 => handler_20(parts, maybe, text)
	21 => handler_21(parts, maybe, text)
	22 => handler_22(parts, maybe, text)
	23 => handler_23(parts, maybe, text)
	24 => handler_24(parts, maybe, text)
	25 => handler_25(parts, maybe, text)
	26 => handler_26(parts, maybe, text)
	27 => handler_27(parts, maybe, text)
	28 => handler_28(parts, maybe, text)
	29 => handler_29(parts, maybe, text)
	_ => reply([line(parts, "?", "not found")])
}

receive : Parts, U64, U64, Str -> Step
receive = |parts, st, method, text| {
	first = dispatch(parts, Ok(st), method, text)
	if (first.count > 3) dispatch(parts, Err(NoState), method + 1, text) else first
}

main! = |args| {
	parts = { names: args, limit: args.len(), tag: "t", verbose: args.len() > 2 }
	var $st = 0.U64
	for a in args {
		step = receive(parts, $st, a.count_utf8_bytes(), a)
		$st = $st + step.count
		for l in step.out {
			echo!(l)
		}
	}
	Ok({})
}
